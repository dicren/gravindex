# Committed template for the root `.env`, which is gitignored.
#
#     cp .env.example .env
#
# ⚠️ Placeholder values only — this repository is public. Never commit a real
# password, host or path here.
#
# Read by `docker-compose.yml` (for `${...}` substitution) and, in local
# non-docker dev, by the backend's config. ⚠️ Setting a variable here does NOT
# inject it into any container: a var the backend needs at runtime must also be
# listed in that service's `environment:` block in `docker-compose.yml`.

# PostgreSQL. `DB_NAME` is the database compose creates on first boot. ⚠️ There
# is deliberately no script in this repo that wipes the `db` volume: it holds
# the data that ships to production. If you genuinely need a clean slate, remove
# the `gravindex_db` docker volume by hand.
DB_USER=gravindex
DB_PASSWORD=gravindex
DB_NAME=gravindex

# Where the backend looks for postgres in local, non-docker dev. Inside the
# compose network services reach it by container name (`gravindex-db`) instead.
DB_HOST=localhost

# Host port published by the `gravindex-db` service. Deliberately NOT 5432: this
# machine may already have a postgres listening there, and a cold
# `docker compose up` has to work without editing anything first.
DB_PORT=5433

# Backend. The port the API listens on when you run it directly on this machine
# (`npm run dev`). ⚠️ Inside docker the container always listens on 3000 and
# `BACKEND_PORT` below decides what that is published as — this value is not
# passed in.
SERVER_PORT=3000

# Host port the `gravindex-api` container is published on. Defaults to 3000, the
# same number as `SERVER_PORT`, on purpose: the Vite dev server proxies `/api`
# to `http://localhost:${SERVER_PORT}`, so with the default the SPA dev server
# talks to the compose backend with no configuration at all (see the README's
# "Modo desarrollo"). Change it only if something else already holds 3000 — and
# change `PUBLIC_URL` to match, or shared links will claim the wrong port.
BACKEND_PORT=3000

# CORS is opt-in and must be `true` in local dev, where the SPA's dev server
# runs on a different port. In the target deployment the backend serves the SPA
# itself, so the two share an origin and this goes back to `false`.
CORS=true

# Absolute public origin of the site, no trailing slash. Used to build the
# absolute `og:url` the social-preview meta tags need — a relative one is
# ignored by every crawler. ⚠️ Placeholder: the real value belongs in the local
# `.env`, never here.
PUBLIC_URL=http://localhost:3000

# Where the backend looks for the built SPA it serves. Relative paths resolve
# from the backend's working directory. Absent is not fatal: the API still runs
# and logs a warning, so `npm run dev` works before the frontend is built.
# ⚠️ Not used by docker: the image bakes this in, pointing at the SPA build the
# Dockerfile produced.
SPA_DIST_PATH=../frontend/dist

# Signing key for the admin surface's JWTs. There is no default and there should
# not be: a fallback constant is a key that everyone with the repository knows,
# and this repository is public. The backend refuses to boot without it.
# Generate one with `openssl rand -hex 32`.
JWT_SECRET=change-me-a-long-random-string

# ── Test infrastructure only ─────────────────────────────────────────────────
# This never touches `gravindex-db` — the database that ships to production.
# It feeds a separate, freely disposable stack that only `test:*` starts. Its
# data is the synthetic fixture in `test/testdb/fixture.sql`; nothing to set here.

# Host port published by the disposable `gravindex-test-db` service that
# `test:e2e` runs against (profile `test`). Never 5432 or `DB_PORT` above —
# this is a second, throwaway Postgres next to the real one.
TEST_DB_PORT=5434

# ── Episode ingestion (scheduled, no HTTP surface) ───────────────────────────
# Cron expression for the RSS ingestion job. `off`, `false`, `no`, `0` or empty
# disable it entirely. Run it once by hand with:
#     npm run build && node dist/ingest/ingest.cli.js
INGEST_CRON=0 5 * * *
INGEST_TIMEZONE=UTC
INGEST_FEED_URL=https://gravina82.com/feed/
INGEST_TIMEOUT_MS=30000

# ── Waveforms (chained after every ingestion tick) ───────────────────────────
# Measures a newly ingested episode's audio and stores the result in
# `episode.waveform` — see `packages/backend/AGENTS.md`, "Waveforms". `off`,
# `false`, `no`, `0` or empty disable the chained top-up (ingestion still
# runs). Needs `ffmpeg` on `PATH`; its absence degrades to a per-episode
# warning, never a boot failure. Run the full backfill once by hand with:
#     npm run build && node dist/waveform/waveform.cli.js
WAVEFORM_ENABLED=true
# Deliberately small: a newly ingested batch can be over a hundred episodes,
# and downloading + decoding all of them in one nightly tick would turn a cron
# run into hours of outbound traffic. `waveform.cli.ts --limit` is the tool for
# a deliberate bulk catch-up.
WAVEFORM_MAX_PER_RUN=5
WAVEFORM_FFMPEG_PATH=ffmpeg
WAVEFORM_TIMEOUT_MS=900000

# ── Frontend ─────────────────────────────────────────────────────────────────
# Where the SPA sends its API calls. Empty — the default — means SAME ORIGIN,
# which is what production wants (the backend serves both the SPA and the API)
# and what split dev wants too (Vite proxies `/api` to the backend). Set an
# absolute origin only to bypass that proxy, which then needs `CORS=true` above.
VITE_API_BASE_URL=

# Dev-server only, never bundled: the target the Vite `/api` proxy forwards to.
# Defaults to `http://localhost:${SERVER_PORT}`, so you only need it if the
# backend runs somewhere else.
BACKEND_URL=

# GA4 measurement id for the SPA, e.g. `G-XXXXXXXXXX`. ⚠️ Empty is a working
# configuration: with no id the app loads no analytics, sets no cookie and shows
# no consent banner — the normal state in dev and in this public repo. Never
# commit a real id here.
VITE_GA4_ID=
