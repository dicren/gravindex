  "info": {
    "title": "Gravindex API",
    "description": "Índice gravinero — clips, episodes and tags of the gravina82 podcast",
    "version": "2.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string",
            "example": "ok"
          },
          "version": {
            "type": "string",
            "description": "The backend package's version",
            "example": "2.0.0"
          },
          "time": {
            "type": "string",
            "description": "Server time, UTC ISO-8601",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "version",
          "time"
        ]
      },
      "ClipEpisodeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 63
          },
          "title": {
            "type": "string",
            "example": "Episodio 86 (Spanish Zombies)"
          },
          "cover": {
            "type": "string",
            "description": "Cover image URL."
          },
          "file": {
            "type": "string",
            "description": "The remote mp3 the browser streams. Not hosted here."
          },
          "originalUrl": {
            "type": "string",
            "description": "The episode's page on gravina82.com."
          },
          "date": {
            "type": "string",
            "description": "Publish date, UTC ISO-8601.",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "cover",
          "file",
          "originalUrl",
          "date"
        ]
      },
      "ClipTagDto": {
        "type": "object",
        "properties": {
          "clipId": {
            "type": "number",
            "description": "Owning clip id.",
            "example": 178
          },
          "tag": {
            "type": "string",
            "description": "Free text, as submitted.",
            "example": "Mulata"
          }
        },
        "required": [
          "clipId",
          "tag"
        ]
      },
      "ClipListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "THE public identifier: `https://indice.gravina82.com/<id>` is the permalink.",
            "example": 178
          },
          "title": {
            "type": "string",
            "example": "La mulata del clítor..."
          },
          "start": {
            "type": "number",
            "description": "Offset into the episode, in whole seconds.",
            "example": 792
          },
          "end": {
            "type": "number",
            "description": "Offset into the episode, in whole seconds.",
            "example": 870
          },
          "episode": {
            "$ref": "#/components/schemas/ClipEpisodeDto"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClipTagDto"
            }
          },
          "up": {
            "type": "number",
            "description": "Number of upvotes. Not a column — aggregated per request.",
            "example": 15
          },
          "points": {
            "type": "number",
            "description": "The sort key. Identical to `up`: every vote is positive.",
            "example": 15
          }
        },
        "required": [
          "id",
          "title",
          "start",
          "end",
          "episode",
          "tags",
          "up",
          "points"
        ]
      },
      "ClipListResponseDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "description": "Rows matching the query, ignoring pagination.",
            "example": 180
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClipListItemDto"
            }
          }
        },
        "required": [
          "total",
          "results"
        ]
      },
      "ClipDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "THE public identifier: `https://indice.gravina82.com/<id>` is the permalink.",
            "example": 178
          },
          "title": {
            "type": "string",
            "example": "La mulata del clítor..."
          },
          "start": {
            "type": "number",
            "description": "Offset into the episode, in whole seconds.",
            "example": 792
          },
          "end": {
            "type": "number",
            "description": "Offset into the episode, in whole seconds.",
            "example": 870
          },
          "episode": {
            "$ref": "#/components/schemas/ClipEpisodeDto"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClipTagDto"
            }
          },
          "up": {
            "type": "number",
            "description": "Number of upvotes. Not a column — aggregated per request.",
            "example": 15
          }
        },
        "required": [
          "id",
          "title",
          "start",
          "end",
          "episode",
          "tags",
          "up"
        ]
      },
      "CreateClipDto": {
        "type": "object",
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0,
            "description": "Offset into the episode, in whole seconds."
          },
          "end": {
            "type": "number",
            "minimum": 1,
            "description": "Offset into the episode, in whole seconds. Must be greater than `start`."
          },
          "title": {
            "type": "string",
            "maxLength": 255
          },
          "tags": {
            "maxItems": 50,
            "description": "Free-text tags. May be empty; duplicates are collapsed.",
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 255
            }
          },
          "episode": {
            "type": "number",
            "minimum": 1,
            "description": "Id of the episode this clip is cut from."
          }
        },
        "required": [
          "start",
          "end",
          "title",
          "tags",
          "episode"
        ]
      },
      "PlaybackResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Id of the appended playback row.",
            "example": 3814
          }
        },
        "required": [
          "id"
        ]
      },
      "VoteResponseDto": {
        "type": "object",
        "properties": {
          "delete": {
            "type": "number",
            "description": "The value of the vote this call removed, or 0. Non-zero only when changing sides.",
            "example": 0
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "`'you have already voted'` when the same vote was already cast, otherwise null.",
            "example": null
          },
          "add": {
            "type": "number",
            "description": "The value of the vote this call recorded, or 0.",
            "example": 1
          }
        },
        "required": [
          "delete",
          "error",
          "add"
        ]
      },
      "EpisodeListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Public identifier. `/episode/<id>-<slug>` is the shareable URL.",
            "example": 63
          },
          "title": {
            "type": "string",
            "example": "Episodio 86 (Spanish Zombies)"
          },
          "cover": {
            "type": "string",
            "description": "Cover image URL."
          },
          "file": {
            "type": "string",
            "description": "The remote mp3 the browser streams. Not hosted here."
          },
          "originalUrl": {
            "type": "string",
            "description": "The episode's page on gravina82.com."
          },
          "date": {
            "type": "string",
            "description": "Publish date, UTC ISO-8601.",
            "format": "date-time"
          },
          "clipCount": {
            "type": "number",
            "description": "How many clips have been cut from this episode.",
            "example": 7
          }
        },
        "required": [
          "id",
          "title",
          "cover",
          "file",
          "originalUrl",
          "date",
          "clipCount"
        ]
      },
      "EpisodeListResponseDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "description": "Rows matching the query, ignoring pagination.",
            "example": 180
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EpisodeListItemDto"
            }
          }
        },
        "required": [
          "total",
          "results"
        ]
      },
      "EpisodeClipDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "THE public identifier: `https://indice.gravina82.com/<id>` is the permalink.",
            "example": 178
          },
          "title": {
            "type": "string",
            "example": "La mulata del clítor..."
          },
          "start": {
            "type": "number",
            "description": "Offset into the episode, in whole seconds.",
            "example": 792
          },
          "end": {
            "type": "number",
            "description": "Offset into the episode, in whole seconds.",
            "example": 870
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClipTagDto"
            }
          },
          "up": {
            "type": "number",
            "description": "Number of upvotes.",
            "example": 15
          }
        },
        "required": [
          "id",
          "title",
          "start",
          "end",
          "tags",
          "up"
        ]
      },
      "EpisodeDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Public identifier. `/episode/<id>-<slug>` is the shareable URL.",
            "example": 63
          },
          "title": {
            "type": "string",
            "example": "Episodio 86 (Spanish Zombies)"
          },
          "cover": {
            "type": "string",
            "description": "Cover image URL."
          },
          "file": {
            "type": "string",
            "description": "The remote mp3 the browser streams. Not hosted here."
          },
          "originalUrl": {
            "type": "string",
            "description": "The episode's page on gravina82.com."
          },
          "date": {
            "type": "string",
            "description": "Publish date, UTC ISO-8601.",
            "format": "date-time"
          },
          "clips": {
            "description": "Every clip cut from this episode, oldest id first. Empty when there are none.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EpisodeClipDto"
            }
          }
        },
        "required": [
          "id",
          "title",
          "cover",
          "file",
          "originalUrl",
          "date",
          "clips"
        ]
      },
      "EpisodeWaveformDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "number",
            "description": "Seconds into the episode this slice starts at, clamped to what the stored waveform actually covers.",
            "example": 0
          },
          "to": {
            "type": "number",
            "description": "Seconds into the episode this slice ends at, clamped the same way.",
            "example": 60
          },
          "points": {
            "type": "number",
            "description": "How many bytes `peaks` carries. May be fewer than requested — never more.",
            "example": 160
          },
          "peaks": {
            "type": "string",
            "description": "One unsigned byte per point (0–255, a normalized peak), base64-encoded. Empty string when the episode has no waveform yet.",
            "example": "AAECAw=="
          }
        },
        "required": [
          "from",
          "to",
          "points",
          "peaks"
        ]
      },
      "TagCountDto": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "description": "The tag, exactly as stored.",
            "example": " Canciones"
          },
          "count": {
            "type": "number",
            "description": "How many clips carry it.",
            "example": 19
          }
        },
        "required": [
          "tag",
          "count"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer token for the `Authorization` header."
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "username"
        ]
      },
      "AdminIdentityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username"
        ]
      },
      "AdminClipDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "description": "Seconds from the start of the episode."
          },
          "end": {
            "type": "number",
            "description": "Seconds from the start of the episode."
          },
          "episodeId": {
            "type": "number"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "start",
          "end",
          "episodeId",
          "tags"
        ]
      },
      "UpdateClipDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "pattern": "\\S"
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds from the start of the episode."
          },
          "end": {
            "type": "number",
            "minimum": 1,
            "description": "Seconds from the start of the episode."
          }
        }
      },
      "RenameTagDto": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "maxLength": 255,
            "description": "The existing tag on this clip."
          },
          "newTag": {
            "type": "string",
            "maxLength": 255,
            "pattern": "\\S",
            "description": "What it becomes."
          }
        },
        "required": [
          "tag",
          "newTag"
        ]
      }
    }
  }
}
