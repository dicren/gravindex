{
  // The build tooling itself, which runs in Node rather than the browser.
  // ⚠️ `eslint.config.mjs` is deliberately NOT listed: it is `.mjs` (matching
  // the root and the backend), and including plain JS here would mean turning
  // on `allowJs` for the whole project just to type-check a config file.
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["vite.config.ts", "vitest.config.ts", "openapi-ts.config.ts"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    // `vitest.config.ts` imports `./vite.config.ts` WITH its extension: Vite's
    // upcoming native config loader warns about extensionless relative imports.
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
